{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "lc3",
  "word": "mnemonic",
  "rules": {
    "document": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "comment"
          },
          {
            "type": "SYMBOL",
            "name": "end_directive"
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "SYMBOL",
                "name": "line"
              },
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "SYMBOL",
                    "name": "comment"
                  },
                  {
                    "type": "BLANK"
                  }
                ]
              },
              {
                "type": "CHOICE",
                "members": [
                  {
                    "type": "STRING",
                    "value": "\n"
                  },
                  {
                    "type": "STRING",
                    "value": "\u0000"
                  }
                ]
              }
            ]
          },
          {
            "type": "STRING",
            "value": "\n"
          },
          {
            "type": "STRING",
            "value": "\u0000"
          }
        ]
      }
    },
    "comment": {
      "type": "PATTERN",
      "value": ";[^\\n]*"
    },
    "end_directive": {
      "type": "PREC",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "period"
          },
          {
            "type": "SYMBOL",
            "name": "end_name"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "comment"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "PATTERN",
            "value": "[^\\x00]*"
          }
        ]
      }
    },
    "end_name": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "end",
          "flags": "i"
        }
      }
    },
    "line": {
      "type": "REPEAT1",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "comma"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "mnemonic"
              },
              {
                "type": "SYMBOL",
                "name": "alias"
              },
              {
                "type": "SYMBOL",
                "name": "directive"
              },
              {
                "type": "SYMBOL",
                "name": "register"
              },
              {
                "type": "SYMBOL",
                "name": "integer"
              },
              {
                "type": "SYMBOL",
                "name": "string"
              },
              {
                "type": "SYMBOL",
                "name": "colon"
              },
              {
                "type": "SYMBOL",
                "name": "label"
              }
            ]
          }
        ]
      }
    },
    "mnemonic": {
      "type": "PATTERN",
      "value": "add|and|not|jmp|ret|jsr|jsrr|lea|ld|st|ldi|sti|ldr|str|brn?z?p?|trap|rti",
      "flags": "i"
    },
    "alias": {
      "type": "PATTERN",
      "value": "getc|out|puts|in|putsp|putn|halt|reg",
      "flags": "i"
    },
    "directive": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "period"
        },
        {
          "type": "SYMBOL",
          "name": "directive_name"
        }
      ]
    },
    "directive_name": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[a-z_]+",
          "flags": "i"
        }
      }
    },
    "register": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "r[0-7]",
          "flags": "i"
        }
      }
    },
    "integer": {
      "type": "CHOICE",
      "members": [
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 1,
            "content": {
              "type": "PATTERN",
              "value": "[-+]?0?x[-+]?[0-9a-f][0-9a-f_]*",
              "flags": "i"
            }
          }
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 1,
            "content": {
              "type": "PATTERN",
              "value": "[-+]?0?b[01][01_]*",
              "flags": "i"
            }
          }
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 1,
            "content": {
              "type": "PATTERN",
              "value": "[-+]?0?o[0-7][0-7_]*",
              "flags": "i"
            }
          }
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 1,
            "content": {
              "type": "PATTERN",
              "value": "#?[-+]?[0-9][0-9_]*"
            }
          }
        },
        {
          "type": "TOKEN",
          "content": {
            "type": "PREC",
            "value": 1,
            "content": {
              "type": "PATTERN",
              "value": "'(?:[^'\\\\]|\\\\[\\s\\S])*'"
            }
          }
        }
      ]
    },
    "string": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "\"(?:[^\"\\\\\\n]|\\\\[\\s\\S])*\"?"
        }
      }
    },
    "label": {
      "type": "PATTERN",
      "value": "[A-Za-z_][A-Za-z0-9_]*"
    },
    "period": {
      "type": "STRING",
      "value": "."
    },
    "comma": {
      "type": "STRING",
      "value": ","
    },
    "colon": {
      "type": "STRING",
      "value": ":"
    }
  },
  "extras": [
    {
      "type": "STRING",
      "value": "\r"
    },
    {
      "type": "STRING",
      "value": "\t"
    },
    {
      "type": "STRING",
      "value": " "
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}